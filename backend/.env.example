# Application
APP_NAME=AgentOps Platform
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL (async SQLAlchemy URL)
DATABASE_URL=postgresql+asyncpg://agentops:agentops@localhost:5432/agentops

# Google Cloud (Vertex AI Reasoning Engines)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Optional: also read by Vertex SDK if GCP_PROJECT_ID unset
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Datasets & evaluations
DATASET_STORAGE_DIR=data/datasets
EVALUATION_TIMEOUT_SECONDS=120
EVALUATION_MAX_RETRIES=2

# Concurrency
INVOKE_CONCURRENCY=8
JUDGE_CONCURRENCY=6

# Evaluation judge (Gemini on Vertex AI, via ADC)
JUDGE_MODEL=gemini-2.5-flash
JUDGE_TEMPERATURE=0.0
METRIC_PASS_THRESHOLD=0.7

# Comma-separated allowed origins. Empty means "*" in development, none in prod.
CORS_ORIGINS=

# Runs still 'running' this long after a restart are marked failed on boot.
ORPHANED_RUN_TIMEOUT_MINUTES=60

# Concurrent attacks per red-team scan
REDTEAM_CONCURRENCY=5
